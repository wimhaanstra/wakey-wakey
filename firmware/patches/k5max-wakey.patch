+void wakey_cycle_idle_timeout(void) {
+    uint8_t next = 0;
+    for (uint8_t i = 0; i < ARRAY_SIZE(wakey_steps); i++) {
+        if (wakey_steps[i].seconds == wakey_idle_seconds) {
+            next = (i + 1) % ARRAY_SIZE(wakey_steps);
+            break;
+        }
+    }
