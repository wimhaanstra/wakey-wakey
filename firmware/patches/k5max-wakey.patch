+/* Stored in QMK's legacy 32-bit user value: high half is a magic tag, low half the seconds.
+ *
+ * The user *datablock* (EECONFIG_USER_DATA_SIZE) is deliberately NOT used. Reserving it shifts every
+ * EEPROM offset after it — including Keychron's custom-RGB and wireless config regions — which
+ * corrupts their contents. This value lives in a fixed, pre-existing slot. */
+static uint16_t wakey_idle_seconds = WAKEY_IDLE_DEFAULT_SECONDS;
+
+static void wakey_config_load(void) {
+    uint32_t stored = eeconfig_read_user();
+    if ((stored >> 16) == WAKEY_CONFIG_MAGIC) wakey_idle_seconds = stored & 0xFFFF;
+}
+
+static void wakey_config_save(void) {
+    eeconfig_update_user(((uint32_t)WAKEY_CONFIG_MAGIC << 16) | (wakey_idle_seconds & 0xFFFF));
