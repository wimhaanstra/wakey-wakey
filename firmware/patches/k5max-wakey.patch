+/* Raw-HID 0xA5: 0x01 get, 0x02 set. Status in data[2] (set here), payload from data[3]. */
+void wakey_config_command(uint8_t *data) {
+    switch (data[1]) {
+        case 0x01:
+            data[3] = wakey_idle_seconds & 0xFF;
+            data[4] = (wakey_idle_seconds >> 8) & 0xFF;
+            break;
+
+        case 0x02: {
+            uint16_t seconds = (uint16_t)data[3] | ((uint16_t)data[4] << 8);
+            if (seconds > 3600) seconds = 3600;
+            wakey_idle_seconds = seconds;
+            wakey_config_save();
+            break;
+        }
+
+        default:
+            data[2] = 1; /* failure */
+            return;
+    }
+    data[2] = 0; /* success */
