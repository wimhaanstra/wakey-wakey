+static const wakey_step_t *wakey_current_step(void) {
+    for (uint8_t i = 0; i < ARRAY_SIZE(wakey_steps); i++) {
+        if (wakey_steps[i].seconds == wakey_idle_seconds) return &wakey_steps[i];
+    }
+    return NULL;
+}
