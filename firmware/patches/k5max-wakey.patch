+/* Wakey: Fn+Y handler and the LED indicator that shows the selected timeout. */
+bool process_record_user(uint16_t keycode, keyrecord_t *record) {
+    /* Every key event feeds the idle clock, so the LED timeout only counts real inactivity. */
+    extern void wakey_note_activity(uint16_t keycode);
+    wakey_note_activity(keycode);
+
+    if (keycode == WK_IDLE) {
+        if (record->event.pressed) {
+            extern void wakey_cycle_idle_timeout(void);
+            wakey_cycle_idle_timeout();
+        }
+        return false;
+    }
+    return true;
+}
